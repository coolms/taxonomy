{
    "name": "coolms/taxonomy",
    "description": "Taxonomy trees and nodes: entities, repository contracts and the tree service.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/coolms/taxonomy/issues",
        "source": "https://github.com/coolms/taxonomy"
    },
    "require": {
        "php": "^8.5",
        "coolms/core": "^2.0",
        "coolms/entity": "^2.0.0-alpha3",
        "coolms/rql": "^1.0",
        "doctrine/collections": "^2.2",
        "symfony/uid": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Taxonomy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Taxonomy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
